{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt=sd_xl_base_1.0.safetensors}}"
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{int:width=1024}}",
      "height": "{{int:height=1024}}",
      "batch_size": "{{int:batch=1}}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative=lowres, bad anatomy, worst quality}}",
      "clip": ["4", 1]
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed:seed}}",
      "steps": "{{int:steps=20}}",
      "cfg": "{{float:cfg=7.0}}",
      "sampler_name": "{{sampler=euler}}",
      "scheduler": "{{scheduler=normal}}",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "comfyui_agent",
      "images": ["8", 0]
    }
  }
}