{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "typeRoots": [
      "./pi-web-search/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {}
  },
  "include": [
    "pi-autopilot/**/*.ts",
    "pi-memory/**/*.ts",
    "pi-context/**/*.ts",
    "subagent/**/*.ts",
    "plan-mode/**/*.ts",
    "pi-browser/**/*.ts",
    "pi-web-search/**/*.ts",
    "pi-tmux/**/*.ts",
    "pi-voice/**/*.ts",
    "pi-link/**/*.ts"
  ]
}
