# 自动生成的 session 文件
agent/sessions/

# npm 安装的依赖（统一根：agent/package.json → agent/node_modules，10 扩展共享）
agent/node_modules/
agent/package-lock.json
# 防护：个别扩展若出现独立依赖，不入库（rebuild 时应清理回统一根）
agent/extensions/*/node_modules/
agent/extensions/*/package-lock.json

# pi 运行时缓存
context-mode/
agent/bin/
agent/auth.json
agent/trust.json

# pi 自动生成的计划文件
plans/
.restore_progress

# Python 字节码缓存
__pycache__/
*.pyc

# searxng: 密钥文件（含 secret_key）
searxng/settings.yml

# searxng: Python 虚拟环境
searxng/venv/

# searxng: 原始开源项目
searxng/repo/

# pi-admin 运行时状态文件
agent/.pi-admin-state.json

# 日志文件
*.log

# SQLite 数据库文件
*.db

# searxng: 运行时 PID 文件
searxng/searxng.pid

# 代理配置（可能含 API Key）
agent/settings.json
agent/models.json

# 环境变量文件（可能含密钥）
.env
.env.*

# ctx-lite 运行时数据（已并入 pi-memory）
ctx-lite/

# pi-memory 数据：笔记+记忆+摘要+检查点（已确认无密钥，入库备份）
# 排除项：原始对话提取/临时提取（含对话全文，可能含敏感内容如 PAT 明文）
memory/extract-sessions/
memory/pending-extracts/
memory/.extract-lock
memory/extract-tracker.json
# 多环境隔离（P1）：notes/summaries 为会话级/环境特定数据，不入库（避免多机 pull/push 互相覆盖）
# entries.json（长期记忆）仍入库共享，冲突时以最新 push 为准
memory/notes.json
memory/summaries.json
agent/models-store.json



# pi-scheduler 运行时数据
agent/scheduled-tasks.json

# pi-autopilot 运行时数据（config.json 入库共享，见 AGENTS.md 多环境约定）
agent/.pi-autopilot-telemetry.json
agent/.pi-autopilot-lastgood.json
agent/.pi-autopilot-crash.json

# pi-context 用量诊断运行时数据
agent/.usage-diag.jsonl

# 跨会话统计（cache-guard/工具指纹/用量聚合，运行时数据不入库）
agent/stats/
agent/extensions/*/node_modules

# 运行时日志（pi-tmux/pi-voice/pi-bg/scheduler/wrapper/selfcheck 时间戳等全部运行时数据，不入库）
logs/
agent/.pi-tmux-registry.json
agent/pi-voice.json


# 类型链接与 wrapper 运行时锚点
agent/extensions/node_modules/
scripts/.pi-cli-path
# pi-cron 运行时日志
logs/scheduler/

# pi-memory 压缩检查点（瞬时快照，时效性数据，不入库）
memory/checkpoints/

# pi-backup 配置变更基线（gitignored 配置的 sha256 快照，不入库）
.backup-baseline/
pi-link.json
# pi-link 运行时状态（T2 活跃设备/身份机制，每次连接刷新，跨环境无意义）
pi-link-active.json
pi-link-state.json
pi-link-outbox.json
# rebuild 运行日志
logs/*.out
deploy/tmux/tmux-status.txt
agent/extensions/tsconfig.local.json
# 便携 pi 完整包（含 .pi 密钥内容）不入库；仓库只跟踪 portable/ 下的脚本
portable/.pi/
deploy/tmux/*.lock

