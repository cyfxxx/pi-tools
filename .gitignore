# 自动生成的 session 文件
agent/sessions/

# npm 安装的依赖
agent/npm/node_modules/
agent/npm/package-lock.json
agent/extensions/*/node_modules/
agent/extensions/*/package-lock.json

# pi 运行时缓存
context-mode/
agent/bin/
agent/auth.json
agent/trust.json

# pi 自动生成的计划文件
plans/
.restore_progress

# Python 字节码缓存
__pycache__/
*.pyc

# searxng: 密钥文件（含 secret_key）
searxng/settings.yml

# searxng: Python 虚拟环境
searxng/venv/

# searxng: 原始开源项目
searxng/repo/

# pi-admin 运行时状态文件
agent/.pi-admin-state.json

# 日志文件
*.log

# SQLite 数据库文件
*.db

# searxng: 运行时 PID 文件
searxng/searxng.pid

# 代理配置（可能含 API Key）
agent/settings.json
agent/models.json

# 环境变量文件（可能含密钥）
.env
.env.*

# ctx-lite 运行时数据（已并入 pi-memory）
ctx-lite/

# pi-memory 运行时数据（笔记+记忆+摘要+检查点）
memory/
agent/models-store.json



# pi-scheduler 运行时数据
agent/scheduled-tasks.json

# pi-autopilot 运行时数据
agent/.pi-autopilot-config.json
agent/.pi-autopilot-telemetry.json
agent/.pi-autopilot-lastgood.json
agent/.pi-autopilot-crash.json

# pi-context 用量诊断运行时数据
agent/.usage-diag.jsonl
agent/extensions/*/node_modules

# pi-tmux 运行时数据
logs/tmux/
agent/.pi-tmux-registry.json
# pi-voice 运行时数据
logs/whisper/
logs/voice/
agent/pi-voice.json


# 类型链接与 wrapper 运行时锚点
agent/extensions/node_modules/
scripts/.pi-cli-path
